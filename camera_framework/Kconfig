menuconfig PKG_USING_CAMERA_FRAMEWORK
    bool "Camera drivers"
    default n
    select RT_USING_SYSTEM_WORKQUEUE
    help
      Enable the camera framework package, including the handle layer, the
      sensor drivers and the data-bus backends.

      The SDK only exposes CAMERA_MODEL / CAMERA_INTERFACE strings. This
      package owns the mapping from those strings to drivers, SPI bus names,
      backends and internal symbols.

if PKG_USING_CAMERA_FRAMEWORK

    # ---- model name -> driver selector ---------------------------------
    config SENSOR_USING_OV2640
        bool
        default y if CAMERA_MODEL = "ov2640"

    config SENSOR_USING_GC032A
        bool
        default y if CAMERA_MODEL = "gc032a"

    config SENSOR_USING_BF30A2
        bool
        default y if CAMERA_MODEL = "bf30a2"

    # ---- model + interface -> backend selector -------------------------
    # Interface names are not free-standing: each one is only valid for the
    # models that really support that wiring. This prevents combinations like
    # GC032A + spi1 or OV2640 + serial2bit from generating a half-configured
    # backend.
    config CAMERA_USING_DVP
        bool
        depends on SOC_SF32LB57X
        default y if CAMERA_MODEL = "ov2640" && CAMERA_INTERFACE = "dvp"
        default y if CAMERA_MODEL = "gc032a" && CAMERA_INTERFACE = "dvp"

    config CAMERA_USING_SERIAL
        bool
        depends on SOC_SF32LB57X
        default y if CAMERA_MODEL = "gc032a" && CAMERA_INTERFACE = "serial2bit"

    config CAMERA_USING_SPI_MODULE
        bool
        default y if CAMERA_MODEL = "ov2640" && CAMERA_INTERFACE = "spi1"
        default y if CAMERA_MODEL = "ov2640" && CAMERA_INTERFACE = "spi2"
        default y if CAMERA_MODEL = "bf30a2" && CAMERA_INTERFACE = "spi1"
        default y if CAMERA_MODEL = "bf30a2" && CAMERA_INTERFACE = "spi2"

    # OV2640 has no serial pixel output; its SPI path is always an ArduCam
    # FIFO module. BF30A2 streams directly over SPI, so it is not included.
    config CAMERA_USING_ARDUCAM_FIFO
        bool
        default y if CAMERA_MODEL = "ov2640" && CAMERA_INTERFACE = "spi1"
        default y if CAMERA_MODEL = "ov2640" && CAMERA_INTERFACE = "spi2"

    # Existing GC032A driver code uses this model+interface selector.
    config CAMERA_GC032A_INTERFACE_SERIAL_2BIT
        bool
        depends on SOC_SF32LB57X
        default y if CAMERA_MODEL = "gc032a" && CAMERA_INTERFACE = "serial2bit"

    # ---- interface string -> SPI instance ------------------------------
    config CAMERA_SPI_BUS
        string
        depends on CAMERA_USING_SPI_MODULE
        default "spi1" if CAMERA_INTERFACE = "spi1"
        default "spi2" if CAMERA_INTERFACE = "spi2"

    # ---- backend -> SDK peripheral ------------------------------------
    config CAMERA_DVP_BACKEND_DCMI
        bool
        depends on SOC_SF32LB57X
        default y if CAMERA_USING_DVP
        select BSP_USING_DCMI

    config CAMERA_SERIAL_SPI_2BIT
        bool
        depends on SOC_SF32LB57X
        default y if CAMERA_USING_SERIAL
        select BSP_USING_DCMI

    # ---- SPI instance -> driver/DMA -----------------------------------
    config CAMERA_SPI_MODULE_SPI1
        bool
        default y if CAMERA_USING_SPI_MODULE && CAMERA_SPI_BUS = "spi1"
        select BSP_USING_SPI
        select BSP_USING_SPI1
        select BSP_SPI1_RX_USING_DMA
        select BSP_SPI1_TX_USING_DMA

    config CAMERA_SPI_MODULE_SPI2
        bool
        default y if CAMERA_USING_SPI_MODULE && CAMERA_SPI_BUS = "spi2"
        select BSP_USING_SPI
        select BSP_USING_SPI2
        select BSP_SPI2_RX_USING_DMA
        select BSP_SPI2_TX_USING_DMA

    # BF30A2 needs circular DMA; the ArduCam FIFO path does not.
    config CAMERA_BF30A2_SPI_DMA_CIRCULAR
        bool
        default y if SENSOR_USING_BF30A2 && CAMERA_USING_SPI_MODULE
        select BSP_USING_SPI_DMA_CIRCULAR

    # ---- SPI device names used by the drivers --------------------------
    config CAMERA_ARDUCAM_SPI_BUS_NAME
        string
        default CAMERA_SPI_BUS if CAMERA_USING_ARDUCAM_FIFO

    config CAMERA_BF30A2_SPI_BUS_NAME
        string
        default CAMERA_SPI_BUS if SENSOR_USING_BF30A2 && CAMERA_USING_SPI_MODULE

    # ---- runtime adapter name -----------------------------------------
    config CAMERA_DATA_BUS_ADAPTER_NAME
        string
        default "dcmi" if CAMERA_SERIAL_SPI_2BIT
        default "dvp" if CAMERA_USING_DVP
        default "arducam_fifo" if CAMERA_USING_ARDUCAM_FIFO

    # ---- derived MCLK requirement --------------------------------------
    # The board owns CAMERA_XCLK_ENABLE and the PWM device/channel macros
    # directly in its Kconfig.board. The component only derives whether the
    # selected sensor needs a clock.
    config CAMERA_XCLK_REQUIRED
        bool
        default y if SENSOR_USING_OV2640 && !CAMERA_USING_ARDUCAM_FIFO
        default y if SENSOR_USING_GC032A
        default y if SENSOR_USING_BF30A2

    # Any supported model/interface combination selects one of the backend
    # symbols above. SConscript uses this to reject unsupported pairs instead
    # of silently building a framework with no backend.
    config CAMERA_CONFIG_VALID
        bool
        default y if CAMERA_USING_DVP
        default y if CAMERA_USING_SERIAL
        default y if CAMERA_USING_SPI_MODULE

    rsource "software/Kconfig"

endif
