menuconfig PKG_USING_CAMERA_FRAMEWORK
    bool "Camera drivers"
    default y if BSP_USING_CAMERA1
    select RT_USING_SYSTEM_WORKQUEUE
    help
      Enable the camera framework package, including the handle layer, the
      sensor drivers, the data-bus backends and the camera hardware settings.

      The package owns the camera model/interface menu. The SDK only keeps
      BSP_USING_CAMERA1 to decide whether the component is pulled in, and the
      board supplies its defaults through configdefault in Kconfig.board.

if PKG_USING_CAMERA_FRAMEWORK

    # ---- board-provided defaults ---------------------------------------
    # The board only reopens the named choices to set their defaults (empty
    # "choice ... default ... endchoice" stubs under BSP_USING_CAMERA1). The
    # complete choices with prompts and members are defined below; when the
    # component is not sourced, the empty board stubs are inert.
    # ---- camera selection (owned by the component) ---------------------
    # The model is a radio choice, so exactly one sensor is selected. The
    # interface is also a per-model radio choice: each model only exposes the
    # links it really supports, and unsupported links never appear in the menu.
    menu "Camera selection"

        choice SENSOR_MODEL
            prompt "Camera model"
            default SENSOR_USING_OV2640

            config SENSOR_USING_OV2640
                bool "OV2640"
                help
                  2 MP sensor. Supported links: 8-bit DVP, or SPI through an
                  ArduCam FIFO module (SPI1/SPI2).

            config SENSOR_USING_GC032A
                bool "GC032A"
                help
                  VGA sensor. Supported links: 8-bit DVP, or 2-bit serial
                  (DCMI SPI packet mode).

            config SENSOR_USING_BF30A2
                bool "BF30A2"
                help
                  Fixed RGB565 240x320 sensor streaming over SPI1 or SPI2.

        endchoice

        choice CAMERA_OV2640_INTERFACE
            prompt "OV2640 interface"
            depends on SENSOR_USING_OV2640
            default CAMERA_OV2640_INTERFACE_DVP

            config CAMERA_OV2640_INTERFACE_DVP
                bool "8-bit DVP (parallel)"
                select CAMERA_USING_DVP
                select CAMERA_DVP_BACKEND_DCMI

            config CAMERA_OV2640_INTERFACE_SPI1
                bool "SPI1 (ArduCam FIFO)"
                select CAMERA_USING_SPI_MODULE
                select CAMERA_USING_ARDUCAM_FIFO

            config CAMERA_OV2640_INTERFACE_SPI2
                bool "SPI2 (ArduCam FIFO)"
                select CAMERA_USING_SPI_MODULE
                select CAMERA_USING_ARDUCAM_FIFO

        endchoice

        choice CAMERA_GC032A_INTERFACE
            prompt "GC032A interface"
            depends on SENSOR_USING_GC032A
            default CAMERA_GC032A_INTERFACE_DVP

            config CAMERA_GC032A_INTERFACE_DVP
                bool "8-bit DVP (parallel)"
                select CAMERA_USING_DVP
                select CAMERA_DVP_BACKEND_DCMI

            config CAMERA_GC032A_INTERFACE_SERIAL2BIT
                bool "2-bit SPI (serial)"
                select CAMERA_USING_SERIAL
                select CAMERA_SERIAL_SPI_2BIT

        endchoice

        choice CAMERA_BF30A2_INTERFACE
            prompt "BF30A2 interface"
            depends on SENSOR_USING_BF30A2
            default CAMERA_BF30A2_INTERFACE_SPI1

            config CAMERA_BF30A2_INTERFACE_SPI1
                bool "SPI1"
                select CAMERA_USING_SPI_MODULE

            config CAMERA_BF30A2_INTERFACE_SPI2
                bool "SPI2"
                select CAMERA_USING_SPI_MODULE

        endchoice

    endmenu

    # ---- backend selectors (selected by the per-model interface) -------
    # The interface choice members `select` these; no model/interface OR
    # conditions are needed here.
    config CAMERA_USING_DVP
        bool

    config CAMERA_USING_SERIAL
        bool

    config CAMERA_USING_SPI_MODULE
        bool

    config CAMERA_USING_ARDUCAM_FIFO
        bool

    # ---- interface option -> SPI instance ------------------------------
    config CAMERA_SPI_BUS
        string
        depends on CAMERA_USING_SPI_MODULE
        default "spi1" if CAMERA_OV2640_INTERFACE_SPI1 || CAMERA_BF30A2_INTERFACE_SPI1
        default "spi2" if CAMERA_OV2640_INTERFACE_SPI2 || CAMERA_BF30A2_INTERFACE_SPI2

    # ---- backend -> SDK peripheral ------------------------------------
    config CAMERA_DVP_BACKEND_DCMI
        bool
        select BSP_USING_DCMI

    config CAMERA_SERIAL_SPI_2BIT
        bool
        select BSP_USING_DCMI

    # ---- SPI instance -> driver/DMA -----------------------------------
    config CAMERA_SPI_MODULE_SPI1
        bool
        default y if CAMERA_USING_SPI_MODULE && CAMERA_SPI_BUS = "spi1"
        select BSP_USING_SPI
        select BSP_USING_SPI1
        select BSP_SPI1_RX_USING_DMA
        select BSP_SPI1_TX_USING_DMA

    config CAMERA_SPI_MODULE_SPI2
        bool
        default y if CAMERA_USING_SPI_MODULE && CAMERA_SPI_BUS = "spi2"
        select BSP_USING_SPI
        select BSP_USING_SPI2
        select BSP_SPI2_RX_USING_DMA
        select BSP_SPI2_TX_USING_DMA

    # BF30A2 needs circular DMA; the ArduCam FIFO path does not.
    config CAMERA_BF30A2_SPI_DMA_CIRCULAR
        bool
        default y if SENSOR_USING_BF30A2 && CAMERA_USING_SPI_MODULE
        select BSP_USING_SPI_DMA_CIRCULAR

    # ---- SPI device names used by the drivers --------------------------
    config CAMERA_ARDUCAM_SPI_BUS_NAME
        string
        default CAMERA_SPI_BUS if CAMERA_USING_ARDUCAM_FIFO

    config CAMERA_BF30A2_SPI_BUS_NAME
        string
        default CAMERA_SPI_BUS if SENSOR_USING_BF30A2 && CAMERA_USING_SPI_MODULE

    # ---- runtime adapter name -----------------------------------------
    config CAMERA_DATA_BUS_ADAPTER_NAME
        string
        default "dcmi" if CAMERA_SERIAL_SPI_2BIT
        default "dvp" if CAMERA_USING_DVP
        default "arducam_fifo" if CAMERA_USING_ARDUCAM_FIFO

    # ---- camera hardware (board values via configdefault) --------------
    menu "Camera hardware"

        config CAMERA_I2C_DEVICE_NAME
            string "I2C device name"
            help
              SCCB I2C bus used by the sensor. The board supplies it through
              "configdefault CAMERA_I2C_DEVICE_NAME" in its Kconfig.board.

        config CAMERA_XCLK_ENABLE
            bool "Camera XCLK (MCLK) output"
            select BSP_USING_PWM
            select BSP_USING_PWMT1 if CAMERA_XCLK_PWM_DEVICE_NAME = "pwmt1"
            select BSP_USING_PWMT2 if CAMERA_XCLK_PWM_DEVICE_NAME = "pwmt2"
            help
              Drive the sensor MCLK/XCLK from a board PWM timer. The pad mux and
              the timer wiring are board hardware: the board only supplies the
              PWM device name and channel as configdefaults in its
              Kconfig.board.

        config CAMERA_XCLK_PWM_DEVICE_NAME
            string "XCLK PWM device name"
            default "" if !CAMERA_XCLK_ENABLE
            help
              RT-Thread PWM device that generates the sensor MCLK, e.g.
              "pwmt2". Only "pwmt1" and "pwmt2" have their timer driver
              selected automatically; a board using another instance enables it
              in its own Kconfig.board/board.conf.

        config CAMERA_XCLK_PWM_CHANNEL
            int "XCLK PWM channel"
            default 0 if !CAMERA_XCLK_ENABLE

    endmenu # Camera hardware

    # ---- derived MCLK requirement --------------------------------------
    # The board owns the CAMERA_XCLK_ENABLE value and the PWM device/channel
    # through configdefault; the component only derives whether the selected
    # sensor needs a clock.
    config CAMERA_XCLK_REQUIRED
        bool
        default y if SENSOR_USING_OV2640 && !CAMERA_USING_ARDUCAM_FIFO
        default y if SENSOR_USING_GC032A
        default y if SENSOR_USING_BF30A2

    # Any supported model/interface combination selects one of the backend
    # symbols above. SConscript uses this to reject unsupported pairs instead
    # of silently building a framework with no backend.
    config CAMERA_CONFIG_VALID
        bool
        default y if CAMERA_USING_DVP
        default y if CAMERA_USING_SERIAL
        default y if CAMERA_USING_SPI_MODULE

    rsource "software/Kconfig"

endif
