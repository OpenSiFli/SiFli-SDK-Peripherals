from building import *
import os

cwd = GetCurrentDir()
sources = []
paths = [cwd + '/include']
defines = []
try:
    Import('CAMERA_SW_JPEG_ENCODER', 'CAMERA_SW_JPEG_DECODER')
except Exception:
    CAMERA_SW_JPEG_ENCODER = GetDepend(['CAMERA_SW_JPEG_ENCODER'])
    CAMERA_SW_JPEG_DECODER = GetDepend(['CAMERA_SW_JPEG_DECODER'])

if CAMERA_SW_JPEG_ENCODER:
    sources += ['src/encoder/camera_sw_jpeg_encoder.cpp',
                'vendor/jpegenc/JPEGENC.cpp']
    paths += [os.path.join(cwd, 'vendor/jpegenc')]
    defines += ['JPEGENC_PORTABLE']
if CAMERA_SW_JPEG_DECODER:
    # The decoder includes its vendored tjpgd.h by relative path so that it
    # always picks up vendor/tjpgd/tjpgdcnf.h. Do NOT add vendor/tjpgd to
    # CPPPATH and do NOT define LV_USE_SJPG here: the build system appends
    # these to the global environment, which would collide with LVGL v8's own
    # sjpg/tjpgd.c (same upstream names, different JDEC layout).
    sources += ['src/decoder/camera_sw_jpeg_decoder.c', 'vendor/tjpgd/tjpgd.c']

group = DefineGroup('Camera Software JPEG', sources, depend=[],
                    CPPPATH=paths, CPPDEFINES=defines, CCFLAGS='-O2')
Return('group')
