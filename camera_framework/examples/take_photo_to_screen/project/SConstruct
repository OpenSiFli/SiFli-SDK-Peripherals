import os
import rtconfig

# Check SDK
SIFLI_SDK = os.getenv('SIFLI_SDK')
if not SIFLI_SDK:
    print("Please run set_env.bat in root folder of SIFLI SDK to set environment.")
    exit()
from building import *

# Prepare environment.
PrepareEnv()

CAMERA_SOFTWARE_ROOT = os.path.abspath(
    os.path.join(GetCurrentDir(), '../components/camera_software'))
# The software ISP and the JPEG codecs are owned by the framework, exactly as in
# examples/acpu and examples/isp; only the ACPU/HCPU glue stays with the example.
CAMERA_ISP_ROOT = os.path.abspath(
    os.path.join(CAMERA_SOFTWARE_ROOT, '../../../../software/isp'))
CAMERA_JPEG_ROOT = os.path.abspath(
    os.path.join(CAMERA_SOFTWARE_ROOT, '../../../../software/jpeg'))
CAMERA_SW_ISP_RUN_ON_HCPU = GetDepend(['CAMERA_SW_ISP_RUN_ON_HCPU'])
CAMERA_SW_ISP_RUN_ON_ACPU = GetDepend(['CAMERA_SW_ISP_RUN_ON_ACPU'])
CAMERA_SW_JPEG_RUN_ON_HCPU = GetDepend(['CAMERA_SW_JPEG_RUN_ON_HCPU'])
CAMERA_SW_JPEG_RUN_ON_ACPU = GetDepend(['CAMERA_SW_JPEG_RUN_ON_ACPU'])
CAMERA_SW_JPEG_ENCODER = GetDepend(['CAMERA_SW_JPEG_ENCODER'])
CAMERA_SW_JPEG_DECODER = GetDepend(['CAMERA_SW_JPEG_DECODER'])
Export('SIFLI_SDK', 'CAMERA_SOFTWARE_ROOT', 'CAMERA_ISP_ROOT',
       'CAMERA_JPEG_ROOT',
       'CAMERA_SW_ISP_RUN_ON_HCPU', 'CAMERA_SW_ISP_RUN_ON_ACPU',
       'CAMERA_SW_JPEG_RUN_ON_HCPU', 'CAMERA_SW_JPEG_RUN_ON_ACPU',
       'CAMERA_SW_JPEG_ENCODER', 'CAMERA_SW_JPEG_DECODER')

################################## change rtconfig.xxx to customize build ########################################

# Add bootloader project
AddBootLoader(SIFLI_SDK,rtconfig.CHIP)

camera_isp_on_acpu = CAMERA_SW_ISP_RUN_ON_ACPU
camera_jpeg_on_acpu = CAMERA_SW_JPEG_RUN_ON_ACPU
if camera_isp_on_acpu or camera_jpeg_on_acpu:
    AddChildProj('acpu', '../acpu', False, core="ACPU")

# Set default compile options
SifliEnv()

TARGET = rtconfig.OUTPUT_DIR + rtconfig.TARGET_NAME + '.' + rtconfig.TARGET_EXT
# Prepare building environment
objs = PrepareBuilding(None)
env = GetCurrentEnv()

# Keep this conservative transfer-rate limit local to camera_57x.
env.AppendUnique(CPPDEFINES=["SDIO_MAX_FREQ=1000000"])

# Build application.
DoBuilding(TARGET, objs)

# Add flash table buld.
AddFTAB(SIFLI_SDK,rtconfig.CHIP, env)

# Generate download .bat script
GenDownloadScript(env)
