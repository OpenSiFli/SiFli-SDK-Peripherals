import os
from building import *

cwd = GetCurrentDir()
objs = []
list = os.listdir(cwd)

# Add SDK
Import('SIFLI_SDK', 'CAMERA_SOFTWARE_ROOT')
objs.extend(SConscript(os.path.join(SIFLI_SDK, 'SConscript'), variant_dir="sifli_sdk", duplicate=0))

# Add application source code
objs.extend(SConscript(cwd+'/../src/SConscript', variant_dir="src", duplicate=0))

# Add the shared camera framework (sensor driver, data bus and camera_handle).
camera_root = os.path.normpath(os.path.join(cwd, '../../../'))
objs.extend(SConscript(os.path.join(camera_root, 'SConscript'),
                       variant_dir='camera_framework',
                       duplicate=0))

Return('objs')
